{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST:-localhost};Port=${DB_PORT:-5432};Database=${DB_NAME:-alienhr_prod};Username=${DB_USER:-alienhr_admin};Password=${DB_PASSWORD:-CHANGE_IN_PRODUCTION};SSL Mode=Require;Trust Server Certificate=false"
  },
  "Jwt": {
    "Key": "${JWT_SECRET_KEY:-CHANGE_IN_PRODUCTION_MIN_32_CHARS_LONG_KEY_HERE_2026}",
    "Issuer": "AlienHR.Production.API",
    "Audience": "AlienHR.Production.Clients",
    "DurationInMinutes": 60
  },
  "EmailSettings": {
    "SmtpHost": "${SMTP_HOST:-smtp.sendgrid.net}",
    "SmtpPort": 587,
    "SenderEmail": "${SMTP_SENDER:-noreply@alienhr.com}",
    "SenderName": "AlienHR Enterprise",
    "Username": "${SMTP_USERNAME:-apikey}",
    "Password": "${SMTP_PASSWORD:-CHANGE_IN_PRODUCTION}",
    "EnableSsl": true,
    "UseMock": false
  },
  "AllowedHosts": "*"
}
